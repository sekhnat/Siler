{
  "_comment": "Merged over manifest.json by scripts/build-extension.mjs for Chromium browsers. `key` pins the ID of an unpacked load (legjbaodpdlommbgpdfcmogjedfgpjae); the Chrome Web Store gives its own.",
  "minimum_chrome_version": "120",
  "key": "",
  "browser_specific_settings": null,
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "storage",
    "scripting",
    "webRequest"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "compat.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://www.facebook.com/*",
        "*://web.facebook.com/*",
        "*://m.facebook.com/*",
        "*://www.instagram.com/*",
        "*://www.tiktok.com/*",
        "*://player.vimeo.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
